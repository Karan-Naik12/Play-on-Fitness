# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign admin Bearer session tokens.
SESSION_SECRET=

# ADMIN_PASSCODE: Optional server-side admin passcode override.
# If left unset, an inline first-run owner setup form lets you claim the admin account.
ADMIN_PASSCODE=

# DB_PATH: Optional custom path for the SQLite database file (defaults to ./data/playonfitness.db).
DB_PATH=

# SUPABASE_URL: Full Supabase project URL (e.g. https://<project-id>.supabase.co).
SUPABASE_URL=

# SUPABASE_PROJECT_ID: Optional Supabase project reference ID used if SUPABASE_URL is omitted.
SUPABASE_PROJECT_ID=

# SUPABASE_PUBLISHABLE_KEY: Supabase public publishable / anon API key.
SUPABASE_PUBLISHABLE_KEY=

# SUPABASE_SERVICE_ROLE_KEY: Optional server-only Supabase service role secret key.
SUPABASE_SERVICE_ROLE_KEY=

